<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 这里的 namespace 必须！必须！必须！写你对应 Mapper 接口的全限定名 -->
<mapper namespace="com.dark_apostle.Mapper.StudentMapper">

    <!-- 你的所有 <select>, <insert>, <update>, <delete> 都写在这里面 -->

    <resultMap id="getByStuName" type="com.dark_apostle.Entity.Student">

        <id column="id" property="id" />
        <result column="grade" property="grade" />
        <result column="name" property="name" jdbcType="VARCHAR" />

        <association property="ts" javaType="com.dark_apostle.Entity.ThesisAuthor">
            <id column="id" property="id"/>
            <result column="name" property="name"/>
            <result column="context" property="context"/>
        </association>

    </resultMap>

    <insert id="RegisterStu">
        INSERT INTO student (id,studentID,name,classID,dormID,password)
        VALUE
        (#{id},#{studentID},#{name},#{classID},#{dormID},#{password})
    </insert>

    <select id="getByID" resultType="com.dark_apostle.Entity.Student">
        SELECT * FROM student WHERE id = #{id}
    </select>

    <!-- 巨坑请注意，如果你要返回一个集合数据请把type写成对应数据对象而不是写成一个java.util.list-->
    <select id="getTitleByName" resultType="java.lang.String">
        SELECT context.title FROM thesis_context context JOIN thesis_database author
        ON context.contentID = author.contentID WHERE author.name = #{name}
    </select>

</mapper>